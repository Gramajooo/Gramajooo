---
import { PERSONAL_INFO, SOCIAL_LINKS, CONTACTO_INFO } from '../constants';

const contactCards = [
  {
    icon: 'fas fa-envelope',
    label: 'Email',
    value: PERSONAL_INFO.email,
    action: 'Enviar correo',
    href: `mailto:${PERSONAL_INFO.email}`,
    color: '#e84393',
  },
  {
    icon: SOCIAL_LINKS.github.icon,
    label: SOCIAL_LINKS.github.name,
    value: SOCIAL_LINKS.github.username,
    action: 'Ver perfil',
    href: SOCIAL_LINKS.github.url,
    color: '#FFFFFF',
  },
  {
    icon: SOCIAL_LINKS.linkedin.icon,
    label: SOCIAL_LINKS.linkedin.name,
    value: SOCIAL_LINKS.linkedin.username,
    action: 'Conectar',
    href: SOCIAL_LINKS.linkedin.url,
    color: '#0A66C2',
  },
];
---

<section id="contacto" class="py-24 relative z-10">
  <div class="max-w-5xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-14" data-reveal>
      <p class="text-primary text-sm font-semibold tracking-widest uppercase mb-3">
        {CONTACTO_INFO.title}
      </p>
      <h2 class="section-title text-white mx-auto after:mx-auto">
        Conta<span class="text-gradient">cto</span>
      </h2>
      <p class="text-white/50 mt-5 max-w-lg mx-auto text-sm sm:text-base leading-relaxed">
        {CONTACTO_INFO.subtitle}
      </p>
    </div>

    <!-- Redes y Contacto (Cards centradas) -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-4xl mx-auto" data-reveal>
      {contactCards.map(item => (
        <a
          href={item.href}
          target={item.href.startsWith('mailto:') ? undefined : '_blank'}
          rel={item.href.startsWith('mailto:') ? undefined : 'noopener'}
          class="contact-card group glass-card p-6 sm:p-8 rounded-3xl border-white/[0.08] hover:border-primary/40 flex flex-col items-center text-center justify-between gap-6 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-glow"
        >
          <!-- Icon -->
          <div
            class="w-16 h-16 rounded-2xl flex items-center justify-center text-2xl transition-all duration-300 group-hover:scale-110"
            style={`color: ${item.color}; background: ${item.color}15; border: 1px solid ${item.color}33`}
          >
            <i class={item.icon}></i>
          </div>

          <!-- Info -->
          <div>
            <p class="text-xs uppercase tracking-wider text-white/40 font-semibold mb-1">
              {item.label}
            </p>
            <p class="text-base font-bold text-white group-hover:text-primary transition-colors truncate max-w-[220px]">
              {item.value}
            </p>
          </div>

          <!-- Action prompt -->
          <span class="inline-flex items-center gap-2 text-xs font-semibold text-primary group-hover:translate-x-0.5 transition-transform">
            <span>{item.action}</span>
            <i class="fas fa-arrow-right text-[10px]"></i>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
