---
import { PERSONAL_INFO, SOCIAL_LINKS, CONTACTO_INFO } from '../constants';

const contactCards = [
  {
    icon: 'fas fa-envelope',
    label: 'Email',
    value: PERSONAL_INFO.email,
    href: `mailto:${PERSONAL_INFO.email}`,
  },
  {
    icon: SOCIAL_LINKS.github.icon,
    label: SOCIAL_LINKS.github.name,
    value: SOCIAL_LINKS.github.username,
    href: SOCIAL_LINKS.github.url,
  },
  {
    icon: SOCIAL_LINKS.linkedin.icon,
    label: SOCIAL_LINKS.linkedin.name,
    value: SOCIAL_LINKS.linkedin.username,
    href: SOCIAL_LINKS.linkedin.url,
  },
  {
    icon: SOCIAL_LINKS.twitter.icon,
    label: SOCIAL_LINKS.twitter.name,
    value: SOCIAL_LINKS.twitter.username,
    href: SOCIAL_LINKS.twitter.url,
  },
];
---

<section id="contacto" class="py-24 relative z-10">
  <div class="max-w-4xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-14" data-reveal>
      <p class="text-primary text-sm font-semibold tracking-widest uppercase mb-3">
        {CONTACTO_INFO.title}
      </p>
      <h2 class="section-title text-white mx-auto after:mx-auto">
        Conta<span class="text-gradient">cto</span>
      </h2>
      <p class="text-white/50 mt-5 max-w-md mx-auto text-sm leading-relaxed">
        {CONTACTO_INFO.subtitle}
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-10">

      <!-- Info Cards -->
      <div class="lg:col-span-2 space-y-4" data-reveal="left">
        {contactCards.map(item => (
          <a
            href={item.href}
            target={item.href.startsWith('mailto:') ? undefined : '_blank'}
            rel={item.href.startsWith('mailto:') ? undefined : 'noopener'}
            class="flex items-center gap-4 glass-card p-4 rounded-2xl border-white/[0.06] hover:border-primary/40 group transition-all duration-300"
          >
            <div class="w-11 h-11 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-300 flex-shrink-0">
              <i class={item.icon}></i>
            </div>
            <div class="min-w-0">
              <p class="text-xs text-white/40 mb-0.5">{item.label}</p>
              <p class="text-sm font-medium text-white/80 group-hover:text-white transition-colors truncate">
                {item.value}
              </p>
            </div>
          </a>
        ))}
      </div>

      <!-- Form -->
      <div class="lg:col-span-3" data-reveal="right">
        <form
          action={CONTACTO_INFO.endpoint}
          method="POST"
          id="contactForm"
          class="glass-card border-white/[0.06] p-8 rounded-3xl space-y-5"
        >
          <div class="grid sm:grid-cols-2 gap-5">
            <div class="w-full">
              <label for="nombre" class="form-label">Nombre</label>
              <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre" class="form-input" />
            </div>
            <div class="w-full">
              <label for="email" class="form-label">Email</label>
              <input type="email" id="email" name="email" required placeholder="tu@email.com" class="form-input" />
            </div>
          </div>
          <div class="w-full">
            <label for="asunto" class="form-label">Asunto</label>
            <input type="text" id="asunto" name="asunto" placeholder="¿En qué puedo ayudarte?" class="form-input" />
          </div>
          <div class="w-full">
            <label for="mensaje" class="form-label">Mensaje</label>
            <textarea id="mensaje" name="mensaje" rows="5" required placeholder="Cuéntame sobre tu proyecto..." class="form-input resize-none"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full justify-center group">
            <i class="fas fa-paper-plane transition-transform group-hover:translate-x-1"></i>
            Enviar mensaje
          </button>
          <p id="formMsg" class="text-center text-sm font-medium hidden"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .form-label {
    @apply block text-xs font-semibold text-white/50 uppercase tracking-wider mb-2;
  }
  .form-input {
    @apply w-full border border-white/10 rounded-xl px-4 py-3 text-white placeholder-white/20 text-sm outline-none transition-all duration-300 focus:border-primary/50;
    background: rgba(255, 255, 255, 0.04);
  }
  .form-input:focus {
    background: rgba(255, 255, 255, 0.07);
    box-shadow: 0 0 0 2px rgba(232, 67, 147, 0.15);
  }
</style>

<script>
  import { CONTACTO_INFO } from '../constants';

  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const formMsg = document.getElementById('formMsg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('[type="submit"]');
    if (!btn || !formMsg) return;

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enviando...';

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        formMsg.textContent = CONTACTO_INFO.successMessage;
        formMsg.className = 'text-center text-sm font-medium text-emerald-400';
        form.reset();
      } else {
        throw new Error();
      }
    } catch {
      formMsg.textContent = CONTACTO_INFO.errorMessage;
      formMsg.className = 'text-center text-sm font-medium text-rose-400';
    }
    formMsg.classList.remove('hidden');
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-paper-plane"></i> Enviar mensaje';
  });
</script>
