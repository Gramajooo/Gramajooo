---
import {
  FORMACION_TABS,
  EXPERIENCIA_INFO,
  SKILLS,
  CURSOS,
} from '../constants';
---

<section id="formacion" class="py-24 relative z-10">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-14" data-reveal>
      <p class="text-primary text-sm font-semibold tracking-widest uppercase mb-3">Mi perfil profesional</p>
      <h2 class="section-title text-white mx-auto after:mx-auto">
        Experiencia &amp; <span class="text-gradient">Skills</span>
      </h2>
    </div>

    <!-- Tab buttons -->
    <div class="flex flex-wrap justify-center gap-2 mb-10" data-reveal>
      {FORMACION_TABS.map((t, i) => (
        <button
          data-tab={t.id}
          class:list={[
            'tab-btn flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-300',
            i === 0
              ? 'bg-primary text-white shadow-glow'
              : 'glass-card text-white/50 hover:text-white border-white/[0.07]',
          ]}
        >
          <i class={t.icon}></i>
          {t.label}
        </button>
      ))}
    </div>

    <!-- Tab panels container -->
    <div class="glass-card border-white/[0.06] p-6 sm:p-10 rounded-3xl min-h-[360px]">

      <!-- Experiencia (Tab 1 - Activo por defecto) -->
      <div id="tab-experiencia" class="tab-panel space-y-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-white/[0.08]">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary text-2xl flex-shrink-0">
              <i class="fas fa-laptop-code"></i>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-white leading-tight">
                {EXPERIENCIA_INFO.role}
              </h3>
              <p class="text-white/40 text-sm mt-0.5">Especializada en React &amp; TypeScript</p>
            </div>
          </div>
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 text-primary border border-primary/25 text-xs font-semibold w-fit">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            {EXPERIENCIA_INFO.years}
          </span>
        </div>

        <!-- Descripción principal -->
        <p class="text-white/80 text-base sm:text-lg leading-relaxed">
          {EXPERIENCIA_INFO.description}
        </p>

        <!-- Highlights / Competencias clave -->
        <div class="grid sm:grid-cols-2 gap-4 pt-2">
          {EXPERIENCIA_INFO.skillsHighlighted.map(item => (
            <div class="glass-card p-5 rounded-2xl border-white/[0.06] hover:border-primary/30 transition-all duration-300">
              <div class="flex items-center gap-2.5 text-primary text-sm font-semibold mb-1.5">
                <i class="fas fa-check-circle text-xs"></i>
                <span class="text-white font-medium">{item.title}</span>
              </div>
              <p class="text-white/50 text-xs sm:text-sm leading-relaxed pl-5">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Skills (Habilidades Técnicas - Sin barras de progreso) -->
      <div id="tab-skills" class="tab-panel hidden space-y-10">
        {Object.entries(SKILLS).map(([cat, items]) => (
          <div>
            <h3 class="text-xs font-bold text-white/50 uppercase tracking-widest mb-6 flex items-center gap-2">
              <span class="block w-6 h-0.5 bg-primary rounded"></span>
              {cat}
            </h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
              {items.map(s => (
                <div class="skill-card group glass-card p-4 rounded-2xl border-white/[0.07] hover:border-primary/40 flex flex-col items-center justify-center text-center gap-3 transition-all duration-300 hover:-translate-y-1 hover:shadow-glow">
                  <div
                    class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl transition-transform duration-300 group-hover:scale-110"
                    style={`color: ${s.color}; background: ${s.color}15; border: 1px solid ${s.color}33`}
                  >
                    <i class={s.icon}></i>
                  </div>
                  <span class="text-sm font-semibold text-white/90 group-hover:text-white transition-colors">
                    {s.name}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Cursos (Formación Complementaria) -->
      <div id="tab-cursos" class="tab-panel hidden space-y-4">
        <h3 class="text-xs font-bold text-white/50 uppercase tracking-widest mb-6 flex items-center gap-2">
          <span class="block w-6 h-0.5 bg-primary rounded"></span>
          Formación Complementaria
        </h3>
        <div class="grid gap-4">
          {CURSOS.map((c, i) => (
            <div class="flex items-center gap-4 sm:gap-6 p-5 rounded-2xl glass-card border-white/[0.06] hover:border-primary/30 transition-all duration-300 group">
              <div class="flex-shrink-0 w-11 h-11 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary font-bold text-sm group-hover:bg-primary group-hover:text-white transition-all duration-300">
                0{i + 1}
              </div>
              <div class="flex-1 min-w-0 flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-4">
                <div>
                  <h4 class="font-semibold text-white text-base leading-snug group-hover:text-primary transition-colors">
                    {c.title}
                  </h4>
                  <p class="text-white/40 text-xs sm:text-sm mt-0.5">{c.org}</p>
                </div>
                <span class="inline-flex items-center gap-1.5 text-xs text-white/50 bg-white/[0.04] px-3 py-1 rounded-full border border-white/[0.06] w-fit">
                  <i class="fas fa-calendar-alt text-primary/70 text-[10px]"></i>
                  {c.period}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.tab-panel');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab!;

      buttons.forEach((b) => {
        const active = b.dataset.tab === target;
        b.classList.toggle('bg-primary', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('shadow-glow', active);
        b.classList.toggle('text-white/50', !active);
      });

      panels.forEach((p) => {
        p.classList.toggle('hidden', p.id !== `tab-${target}`);
      });
    });
  });
</script>
