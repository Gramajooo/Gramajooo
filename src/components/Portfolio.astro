---
import { PROJECTS } from '../constants';
---

<section id="portafolio" class="py-24 relative z-10">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-14" data-reveal>
      <p class="text-primary text-sm font-semibold tracking-widest uppercase mb-3">Mi trabajo</p>
      <h2 class="section-title text-white mx-auto after:mx-auto">
        Porta<span class="text-gradient">folio</span>
      </h2>
      <p class="text-white/50 text-sm mt-4 max-w-lg mx-auto">
        Plataforma web construida con tecnologías modernas.
      </p>
    </div>

    <!-- Grid / Showcase -->
    <div
      class:list={[
        'grid gap-8',
        PROJECTS.length === 1
          ? 'max-w-2xl mx-auto'
          : 'sm:grid-cols-2 lg:grid-cols-3',
      ]}
    >
      {PROJECTS.map((p, i) => (
        <article
          class="project-card group glass-card border-white/[0.08] rounded-3xl overflow-hidden hover:border-primary/40 transition-all duration-500 hover:-translate-y-1.5 hover:shadow-glow-lg flex flex-col"
          data-reveal
          data-reveal-delay={String(((i % 3) + 1) * 100)}
        >
          <!-- Image -->
          <div class="relative overflow-hidden aspect-[16/10] bg-[#12121a]">
            <img
              src={p.image}
              alt={p.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />

            <!-- Overlay on hover (Desktop) -->
            <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6 gap-3">
              {p.demo && (
                <a
                  href={p.demo}
                  target="_blank"
                  rel="noopener"
                  class="link-btn"
                  title="Visitar sitio en vivo"
                  aria-label={`Visitar sitio en vivo de ${p.title}`}
                >
                  <i class="fas fa-external-link-alt"></i>
                </a>
              )}
              {p.github && (
                <a
                  href={p.github}
                  target="_blank"
                  rel="noopener"
                  class="link-btn"
                  title="Ver código en GitHub"
                  aria-label={`Ver código de ${p.title} en GitHub`}
                >
                  <i class="fab fa-github"></i>
                </a>
              )}
            </div>
          </div>

          <!-- Content -->
          <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between">
            <div>
              <div class="mb-3">
                <h3 class="font-serif font-bold text-white text-2xl group-hover:text-primary transition-colors">
                  {p.title}
                </h3>
              </div>
              <p class="text-white/60 text-sm leading-relaxed mb-6">
                {p.description}
              </p>
            </div>

            <div>
              <!-- Tags -->
              <div class="flex flex-wrap gap-2 pt-4 border-t border-white/[0.06] mb-6">
                {p.tags.map(tag => (
                  <span
                    class="text-xs font-semibold px-3 py-1 rounded-full border"
                    style={`color:${tag.color}; border-color:${tag.color}33; background:${tag.color}15`}
                  >
                    {tag.name}
                  </span>
                ))}
              </div>

              <!-- Action buttons -->
              <div class="flex flex-wrap items-center gap-3">
                {p.demo && (
                  <a
                    href={p.demo}
                    target="_blank"
                    rel="noopener"
                    class="btn-primary text-xs !py-2.5 !px-5"
                  >
                    <span>Visitar Web</span>
                    <i class="fas fa-external-link-alt text-xs"></i>
                  </a>
                )}
                {p.github && (
                  <a
                    href={p.github}
                    target="_blank"
                    rel="noopener"
                    class="btn-ghost text-xs !py-2.5 !px-5"
                  >
                    <i class="fab fa-github"></i>
                    <span>Ver Código</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .link-btn {
    @apply w-11 h-11 rounded-full border border-white/20 flex items-center justify-center text-white text-sm transition-all duration-300 hover:border-primary hover:text-primary;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
  }
</style>
