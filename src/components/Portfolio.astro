---
import { PROJECTS } from '../constants';
---

<section id="portafolio" class="py-24 relative z-10">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-14" data-reveal>
      <p class="text-primary text-sm font-semibold tracking-widest uppercase mb-3">Mis trabajos</p>
      <h2 class="section-title text-white mx-auto after:mx-auto">
        Porta<span class="text-gradient">folio</span>
      </h2>
      <p class="text-white/50 text-sm mt-4 max-w-lg mx-auto">
        Una selección de mis proyectos académicos, personales y experimentos de desarrollo web.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {PROJECTS.map((p, i) => (
        <article
          class="project-card group glass-card border-white/[0.07] rounded-2xl overflow-hidden hover:border-primary/40 transition-all duration-500 hover:-translate-y-1 hover:shadow-glow-lg flex flex-col"
          data-reveal
          data-reveal-delay={String(((i % 3) + 1) * 100)}
        >
          <!-- Image -->
          <div class="relative overflow-hidden aspect-video bg-[#12121a]">
            <img
              src={p.image}
              alt={p.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <!-- Overlay on hover -->
            <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-5 gap-3">
              {p.github ? (
                <a
                  href={p.github}
                  target="_blank"
                  rel="noopener"
                  class="link-btn"
                  title="Ver código en GitHub"
                  aria-label={`Ver código de ${p.title} en GitHub`}
                >
                  <i class="fab fa-github"></i>
                </a>
              ) : (
                <span
                  class="link-btn opacity-40 cursor-not-allowed hover:border-white/20 hover:text-white"
                  title="Enlace no disponible aún"
                  aria-label="Enlace a GitHub pendiente"
                >
                  <i class="fab fa-github"></i>
                </span>
              )}

              {p.demo ? (
                <a
                  href={p.demo}
                  target="_blank"
                  rel="noopener"
                  class="link-btn"
                  title="Ver demo en vivo"
                  aria-label={`Ver demo de ${p.title}`}
                >
                  <i class="fas fa-external-link-alt"></i>
                </a>
              ) : (
                <span
                  class="link-btn opacity-40 cursor-not-allowed hover:border-white/20 hover:text-white"
                  title="Demo no disponible aún"
                  aria-label="Demo pendiente"
                >
                  <i class="fas fa-external-link-alt"></i>
                </span>
              )}
            </div>
          </div>

          <!-- Content -->
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-semibold text-white text-lg mb-1 group-hover:text-primary transition-colors">
                {p.title}
              </h3>
              <p class="text-white/50 text-sm leading-relaxed mb-4">
                {p.description}
              </p>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-white/[0.05]">
              {p.tags.map(tag => (
                <span
                  class="text-xs font-semibold px-2.5 py-1 rounded-full border"
                  style={`color:${tag.color}; border-color:${tag.color}33; background:${tag.color}15`}
                >
                  {tag.name}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .link-btn {
    @apply w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white text-sm transition-all duration-300 hover:border-primary hover:text-primary;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
  }
</style>
