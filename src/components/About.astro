---
import { PERSONAL_INFO, ABOUT_STATS, ABOUT_DETAILS } from '../constants';
---

<section id="about" class="py-24 relative z-10">
  <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">

    <!-- Photo side -->
    <div class="relative flex justify-center" data-reveal="left">
      <div class="relative">
        <!-- Glow behind photo -->
        <div class="absolute inset-0 rounded-3xl blur-3xl opacity-20 bg-primary scale-90"></div>
        <img
          src="/img/perfil.jpeg"
          alt={PERSONAL_INFO.name}
          class="relative z-10 w-72 h-80 object-cover rounded-3xl shadow-card border border-white/10"
        />
        <!-- Stat cards -->
        {ABOUT_STATS.map((stat, i) => (
          <div
            class:list={[
              'absolute glass-card px-5 py-3 rounded-2xl shadow-card z-20',
              i === 0
                ? '-bottom-5 -right-6 border-primary/20'
                : '-top-5 -left-6 border-secondary/20',
            ]}
            data-reveal
            data-reveal-delay={String(300 + i * 100)}
          >
            <p class:list={['text-2xl font-black leading-none', stat.highlight ? 'text-gradient' : 'text-white']}>
              {stat.value}
            </p>
            <p class="text-xs text-white/50 mt-0.5">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Text side -->
    <div data-reveal="right">
      <p class="text-primary text-sm font-semibold tracking-widest uppercase mb-3 flex items-center gap-3">
        <span class="block w-8 h-0.5 bg-primary rounded"></span>
        Sobre mí
      </p>
      <h2 class="section-title text-white mb-6">
        About <span class="text-gradient">Me</span>
      </h2>
      <p class="text-white/80 text-lg leading-relaxed mb-5">
        Hola 👋 Mi nombre es <strong class="text-white font-semibold">{PERSONAL_INFO.name}</strong>, {PERSONAL_INFO.bioAbout}
      </p>

      <!-- Info grid -->
      <div class="grid grid-cols-2 gap-4 mb-8">
        {ABOUT_DETAILS.map(item => (
          <div class="glass-card p-4 rounded-xl border-white/[0.06]">
            <i class={`${item.icon} text-primary mb-2`}></i>
            <p class="text-xs text-white/40 mb-0.5">{item.label}</p>
            <p class="text-sm font-medium text-white/90 truncate">{item.value}</p>
          </div>
        ))}
      </div>

      <a href="#contacto" class="btn-primary w-fit">
        <i class="fas fa-envelope"></i>
        Contacto
      </a>
    </div>
  </div>
</section>
